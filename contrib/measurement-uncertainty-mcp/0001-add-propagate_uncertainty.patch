index 3bf37ca..c6e3c1f 100644
--- a/src/measurement_uncertainty_mcp/math_kernel.py
+++ b/src/measurement_uncertainty_mcp/math_kernel.py
@@ -515,3 +515,189 @@ def monte_carlo_propagate(
         "skewness": y_skew,
         "excess_kurtosis": y_kurt,
     }
+
+
+# --- First-order propagation through a formula (GUM 5.1.2, 5.2.2) -----------
+
+
+def _parse_formula(formula: str, input_names: Sequence[str]):
+    """Parse a formula string into a sympy expression over the named inputs.
+
+    Applies the same AST safety gate as `monte_carlo_propagate` before sympy
+    sees the string. Returns (expr, symbols) with symbols in input order.
+    """
+    _validate_formula_ast(formula)
+    sympy = _get_sympy()
+
+    if len(set(input_names)) != len(input_names):
+        raise ValueError("Input names must be unique")
+
+    symbols = sympy.symbols(list(input_names))
+    if not isinstance(symbols, (list, tuple)):
+        symbols = (symbols,)
+    local_dict = dict(zip(input_names, symbols))
+
+    try:
+        expr = sympy.sympify(sympy.parse_expr(formula, local_dict=local_dict))
+    except Exception as e:
+        raise ValueError(f"Could not parse formula {formula!r}: {e}") from e
+
+    if not hasattr(expr, "free_symbols"):
+        raise ValueError(
+            f"Formula {formula!r} did not parse as a valid sympy expression"
+        )
+
+    undefined = {str(sym) for sym in expr.free_symbols} - set(input_names)
+    if undefined:
+        raise ValueError(
+            f"Formula references undefined inputs: {sorted(undefined)}. "
+            f"Known inputs: {list(input_names)}"
+        )
+    return expr, tuple(symbols)
+
+
+def propagate_formula(
+    formula: str,
+    inputs: Sequence[dict],
+    covariances: Sequence[dict] | None = None,
+) -> dict:
+    """Combined standard uncertainty of y = f(x_1..x_n) by the law of
+    propagation of uncertainty, with f given as a formula string.
+
+    Sensitivity coefficients c_i = df/dx_i are derived symbolically and
+    evaluated at the input estimates, so a quantity that appears more than
+    once in the formula (e.g. "s * s") is treated as ONE input, as the GUM
+    requires.
+
+        u_c(y)^2 = sum_i c_i^2 u(x_i)^2                      (GUM 5.1.2, eq. 10)
+                   + 2 sum_{i<j} c_i c_j u(x_i, x_j)         (GUM 5.2.2, eq. 13)
+
+    Parameters
+    ----------
+    formula : str
+        Expression in sympy syntax, e.g. "V / I", "x1 - x2", "s**2".
+    inputs : list of dict
+        Each: {"name": str, "value": float, "u": float, "dof": float (optional)}.
+        `value` is the estimate x_i, `u` its standard uncertainty.
+    covariances : list of dict, optional
+        Each: {"between": [name_a, name_b], "value": float}, the covariance
+        u(x_a, x_b) in the product of the two inputs' units. Pairs not
+        listed are taken as uncorrelated.
+
+    Returns
+    -------
+    dict
+        y_estimate, combined_standard_uncertainty, variance, sensitivities,
+        components (per-input contribution c_i * u_i), covariance_term,
+        effective_dof (Welch-Satterthwaite; None when covariances are given,
+        because that formula assumes uncorrelated inputs), formula, method.
+
+    Notes
+    -----
+    This is the first-order (linear) approximation. For strongly non-linear
+    models or non-Gaussian inputs use `monte_carlo_propagate` instead.
+    """
+    if not inputs:
+        raise ValueError("Need at least one input")
+    names = [str(i["name"]) for i in inputs]
+    expr, symbols = _parse_formula(formula, names)
+    sympy = _get_sympy()
+
+    estimates = {}
+    stds = {}
+    dofs = {}
+    for raw, name in zip(inputs, names):
+        u = float(raw["u"])
+        if u < 0:
+            raise ValueError(f"Standard uncertainty of '{name}' must be >= 0")
+        estimates[name] = float(raw["value"])
+        stds[name] = u
+        dof = raw.get("dof")
+        dofs[name] = float(dof) if dof is not None else math.inf
+
+    subs = {sym: estimates[str(sym)] for sym in symbols}
+
+    def _evaluate(expression, what: str) -> float:
+        problem = ValueError(
+            f"{what} is not a finite real number at the given estimates — "
+            f"check for division by zero, log of non-positive, etc."
+        )
+        try:
+            number = complex(expression.evalf(subs=subs))
+        except Exception as e:
+            # sympy returns zoo/nan for 1/0 and the like; these do not convert.
+            raise problem from e
+        if not (math.isfinite(number.real) and math.isfinite(number.imag)):
+            raise problem
+        if abs(number.imag) > 1e-12 * max(1.0, abs(number.real)):
+            raise problem
+        return number.real
+
+    y0 = _evaluate(expr, "the formula")
+    sens = {
+        str(sym): _evaluate(sympy.diff(expr, sym), f"the derivative with respect to {sym}")
+        for sym in symbols
+    }
+
+    variance = sum((sens[n] * stds[n]) ** 2 for n in names)
+
+    covariance_term = 0.0
+    seen = set()
+    for cov in covariances or ():
+        between = cov.get("between")
+        if not isinstance(between, (list, tuple)) or len(between) != 2:
+            raise ValueError("Each covariance needs 'between': [name_a, name_b]")
+        a, b = str(between[0]), str(between[1])
+        if a == b:
+            raise ValueError(f"Covariance of '{a}' with itself is its variance; pass it as u")
+        if a not in stds or b not in stds:
+            raise ValueError(f"Covariance refers to unknown input(s): {[a, b]}")
+        key = frozenset((a, b))
+        if key in seen:
+            raise ValueError(f"Covariance between '{a}' and '{b}' given more than once")
+        seen.add(key)
+        value = float(cov["value"])
+        if abs(value) > stds[a] * stds[b] * (1 + 1e-12):
+            raise ValueError(
+                f"|u({a},{b})| = {abs(value)} exceeds u({a})*u({b}) = "
+                f"{stds[a] * stds[b]}, which is not possible"
+            )
+        covariance_term += 2.0 * sens[a] * sens[b] * value
+
+    variance_total = variance + covariance_term
+    if variance_total < 0:
+        if variance_total > -1e-12 * max(variance, 1e-300):
+            variance_total = 0.0
+        else:
+            raise ValueError(
+                "The covariances given make the combined variance negative; "
+                "the covariance matrix is not positive semi-definite"
+            )
+    uc = math.sqrt(variance_total)
+
+    applied = [
+        UncertaintyComponent(name=n, value=stds[n], sensitivity=sens[n],
+                             degrees_of_freedom=dofs[n])
+        for n in names
+    ]
+    components = [
+        {"name": c.name, "u": c.value, "sensitivity": c.sensitivity,
+         "contribution": c.contribution}
+        for c in applied
+    ]
+    if covariances:
+        effective_dof = None
+    else:
+        effective_dof = welch_satterthwaite(applied).get("effective_dof")
+
+    return {
+        "y_estimate": y0,
+        "combined_standard_uncertainty": uc,
+        "variance": variance_total,
+        "sensitivities": sens,
+        "components": components,
+        "covariance_term": covariance_term,
+        "effective_dof": effective_dof,
+        "formula": formula,
+        "method": "first-order law of propagation of uncertainty (GUM 5.1.2, 5.2.2)",
+    }
