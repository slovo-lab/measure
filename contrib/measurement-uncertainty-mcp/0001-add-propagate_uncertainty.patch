diff --git a/tests/test_propagate_formula.py b/tests/test_propagate_formula.py
new file mode 100644
index 0000000..6c82973
--- /dev/null
+++ b/tests/test_propagate_formula.py
@@ -0,0 +1,148 @@
+"""First-order propagation through a formula string (GUM 5.1.2, 5.2.2).
+
+Each expected value is worked out by hand in the docstring of its test from
+the law of propagation of uncertainty, not taken from the code under test.
+"""
+import math
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1] / "src"
+sys.path.insert(0, str(ROOT))
+
+from measurement_uncertainty_mcp.math_kernel import (  # noqa: E402
+    monte_carlo_propagate,
+    InputQuantity,
+    propagate_formula,
+)
+
+
+def _in(name, value, u, dof=None):
+    out = {"name": name, "value": value, "u": u}
+    if dof is not None:
+        out["dof"] = dof
+    return out
+
+
+def test_product_uncorrelated():
+    """P = V*I, V = 10 +/- 0.1, I = 2 +/- 0.04.
+    u_c^2 = (2*0.1)^2 + (10*0.04)^2 = 0.04 + 0.16 = 0.20."""
+    out = propagate_formula("V * I", [_in("V", 10.0, 0.1), _in("I", 2.0, 0.04)])
+    assert out["y_estimate"] == pytest.approx(20.0, rel=1e-12)
+    assert out["combined_standard_uncertainty"] == pytest.approx(math.sqrt(0.20), rel=1e-12)
+    assert out["sensitivities"] == pytest.approx({"V": 2.0, "I": 10.0})
+
+
+def test_quotient_uncorrelated():
+    """R = V/I, V = 12 +/- 0.06, I = 3 +/- 0.03.
+    c_V = 1/3, c_I = -12/9. u_c^2 = 0.02^2 + 0.04^2 = 0.002."""
+    out = propagate_formula("V / I", [_in("V", 12.0, 0.06), _in("I", 3.0, 0.03)])
+    assert out["y_estimate"] == pytest.approx(4.0, rel=1e-12)
+    assert out["combined_standard_uncertainty"] == pytest.approx(math.sqrt(0.002), rel=1e-12)
+
+
+def test_linear_combination():
+    """y = 2a + 3b, u(a) = 0.1, u(b) = 0.2. u_c^2 = 0.04 + 0.36 = 0.4."""
+    out = propagate_formula("2*a + 3*b", [_in("a", 1.0, 0.1), _in("b", 2.0, 0.2)])
+    assert out["y_estimate"] == pytest.approx(8.0, rel=1e-12)
+    assert out["combined_standard_uncertainty"] == pytest.approx(math.sqrt(0.4), rel=1e-12)
+
+
+def test_sum_with_positive_covariance():
+    """L = x1 + x2, u = 0.003 and 0.004, u(x1,x2) = 0.000012.
+    u_c^2 = 9e-6 + 16e-6 + 2*12e-6 = 49e-6, so u_c = 0.007.
+    Ignoring the covariance would give 0.005."""
+    out = propagate_formula(
+        "x1 + x2",
+        [_in("x1", 50.0, 0.003), _in("x2", 30.0, 0.004)],
+        covariances=[{"between": ["x1", "x2"], "value": 0.000012}],
+    )
+    assert out["combined_standard_uncertainty"] == pytest.approx(0.007, rel=1e-9)
+    assert out["effective_dof"] is None
+
+
+def test_difference_with_positive_covariance_reduces_uncertainty():
+    """d = x1 - x2, both u = 0.005, u(x1,x2) = 0.000016.
+    u_c^2 = 25e-6 + 25e-6 - 2*16e-6 = 18e-6."""
+    out = propagate_formula(
+        "x1 - x2",
+        [_in("x1", 100.0, 0.005), _in("x2", 40.0, 0.005)],
+        covariances=[{"between": ["x1", "x2"], "value": 0.000016}],
+    )
+    assert out["combined_standard_uncertainty"] == pytest.approx(math.sqrt(18e-6), rel=1e-9)
+
+
+def test_same_input_twice_is_one_quantity():
+    """A = s*s with ONE measured s = 2 +/- 0.01: dA/ds = 2s = 4, u_c = 0.04.
+    Treating the two factors as independent would give 0.0283, which is wrong."""
+    as_product = propagate_formula("s * s", [_in("s", 2.0, 0.01)])
+    as_power = propagate_formula("s**2", [_in("s", 2.0, 0.01)])
+    assert as_product["combined_standard_uncertainty"] == pytest.approx(0.04, rel=1e-12)
+    assert as_power["combined_standard_uncertainty"] == pytest.approx(0.04, rel=1e-12)
+
+
+def test_quantity_minus_itself_has_zero_uncertainty():
+    out = propagate_formula("x - x", [_in("x", 5.0, 0.3)])
+    assert out["y_estimate"] == 0.0
+    assert out["combined_standard_uncertainty"] == 0.0
+
+
+def test_effective_dof_for_uncorrelated_inputs():
+    """Contributions 0.3 (dof 4) and 0.4 (dof 9):
+    nu_eff = 0.5^4 / (0.3^4/4 + 0.4^4/9) = 0.0625 / 0.00486944... = 12.835..."""
+    out = propagate_formula("a + b", [_in("a", 1.0, 0.3, dof=4), _in("b", 1.0, 0.4, dof=9)])
+    expected = 0.5 ** 4 / (0.3 ** 4 / 4 + 0.4 ** 4 / 9)
+    assert out["effective_dof"] == pytest.approx(expected, rel=1e-9)
+
+
+def test_agrees_with_monte_carlo_on_a_linear_gaussian_model():
+    first_order = propagate_formula("a + b", [_in("a", 10.0, 0.3), _in("b", 5.0, 0.4)])
+    mc = monte_carlo_propagate(
+        "a + b",
+        [InputQuantity("a", "normal", {"mean": 10.0, "std": 0.3}),
+         InputQuantity("b", "normal", {"mean": 5.0, "std": 0.4})],
+        n_trials=200_000, seed=1,
+    )
+    assert first_order["combined_standard_uncertainty"] == pytest.approx(0.5, rel=1e-12)
+    assert mc["standard_uncertainty"] == pytest.approx(0.5, rel=0.01)
+
+
+def test_functions_are_differentiated():
+    """y = exp(x) at x = 0: dy/dx = 1, so u_c = u(x)."""
+    out = propagate_formula("exp(x)", [_in("x", 0.0, 0.05)])
+    assert out["combined_standard_uncertainty"] == pytest.approx(0.05, rel=1e-12)
+
+
+def test_undefined_input_is_rejected():
+    with pytest.raises(ValueError, match="undefined inputs"):
+        propagate_formula("a + z", [_in("a", 1.0, 0.1)])
+
+
+def test_impossible_covariance_is_rejected():
+    with pytest.raises(ValueError, match="not possible"):
+        propagate_formula(
+            "a + b", [_in("a", 1.0, 0.1), _in("b", 1.0, 0.1)],
+            covariances=[{"between": ["a", "b"], "value": 0.5}],
+        )
+
+
+def test_covariance_with_unknown_input_is_rejected():
+    with pytest.raises(ValueError, match="unknown input"):
+        propagate_formula(
+            "a + b", [_in("a", 1.0, 0.1), _in("b", 1.0, 0.1)],
+            covariances=[{"between": ["a", "c"], "value": 0.001}],
+        )
+
+
+def test_division_by_zero_is_reported():
+    with pytest.raises(ValueError, match="finite real number"):
+        propagate_formula("a / b", [_in("a", 1.0, 0.1), _in("b", 0.0, 0.1)])
+
+
+def test_unsafe_formula_is_rejected_before_parsing():
+    with pytest.raises(ValueError):
+        propagate_formula("__import__('os').system('true')", [_in("a", 1.0, 0.1)])
+    with pytest.raises(ValueError):
+        propagate_formula("a.real", [_in("a", 1.0, 0.1)])
